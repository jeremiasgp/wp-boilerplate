# setup copies this file and generates all blank passwords. Never commit .env.
# Blank project name generates a unique Compose namespace on first setup.
COMPOSE_PROJECT_NAME=
HTTP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE="WordPress Starter"
WP_ADMIN_USER=starter_admin
WP_ADMIN_EMAIL=admin@example.test
WP_ADMIN_PASSWORD=
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=
